<Window x:Class="AIS_Products_UI.Pages.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара" Height="550" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Новый товар" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Наименование *"/>
                <TextBox x:Name="txtName" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Артикул *"/>
                <TextBox x:Name="txtArticle" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Категория *"/>
                <ComboBox x:Name="cmbCategory" Height="25" Margin="0,5,0,10" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock Text="Цена *"/>
                <TextBox x:Name="txtPrice" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Характеристики"/>
                <TextBox x:Name="txtCharacteristics" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,10"/>

                <TextBlock Text="Описание"/>
                <TextBox x:Name="txtDescription" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Click="BtnSave_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="100" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>