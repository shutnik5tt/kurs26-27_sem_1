<Window x:Class="AIS_Products_UI.Pages.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="350" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F0F0">
        <Border Background="White" Width="300" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Gray" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Авторизация" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Логин"/>
                <TextBox x:Name="txtLogin" Height="25" Margin="0,5,0,10"/>

                <TextBlock Text="Пароль"/>
                <PasswordBox x:Name="txtPassword" Height="25" Margin="0,5,0,20"/>

                <Button Content="Войти" Height="30" Click="BtnLogin_Click"/>
                <TextBlock x:Name="lblError" Foreground="Red" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>