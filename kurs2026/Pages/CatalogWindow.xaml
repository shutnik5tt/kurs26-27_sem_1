<Window x:Class="AIS_Products_UI.Pages.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E0E0E0" Padding="10">
            <StackPanel>
                <TextBlock Text="Меню" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                <Button Content="Каталог" Height="30" Margin="0,0,0,5"/>
                <Button Content="Отчёты" Height="30" Margin="0,0,0,5" IsEnabled="False"/>
                <Button x:Name="btnAddProduct" Content="Добавить товар" Height="30" Margin="0,20,0,5" Click="BtnAddProduct_Click"/>
                <Button Content="Импорт CSV" Height="30" Margin="0,0,0,5" Click="BtnImport_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtSearch" Width="250" Height="25" TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="dgProducts" AutoGenerateColumns="False" IsReadOnly="True" 
                      MouseDoubleClick="DgProducts_MouseDoubleClick" Background="White" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="120"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                    <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>