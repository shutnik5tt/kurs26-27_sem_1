<Window x:Class="AIS_Products_UI.Pages.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт CSV" Height="450" Width="500" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Импорт товаров из CSV" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Height="100" Margin="0,0,0,15">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Файл не выбран" x:Name="lblFileName" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="Выбрать файл" Width="120" Height="25" Click="BtnSelectFile_Click"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="lblStatus" Grid.Row="2" Foreground="Red" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Импортировать" Width="120" Height="30" Click="BtnImport_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="100" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>